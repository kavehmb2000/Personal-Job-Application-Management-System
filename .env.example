# Personal Job Application Management System
# Copy this file to .env.local and replace the placeholder values.
# Never commit real credentials.

# Configured application owner
OWNER_EMAIL=owner@example.com

# PostgreSQL connection
DATABASE_URL=postgresql://user:password@localhost:5432/job_applications

# Authentication/session secret
AUTH_SECRET=replace-with-a-long-random-secret

# Google OAuth / OIDC
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret