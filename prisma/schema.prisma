datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

// -----------------------------------------------------------------------------
// Enums
// -----------------------------------------------------------------------------

enum AuditEventType {
  SIGN_IN
  SIGN_IN_DENIED
  EXPORT_REQUESTED
  ARCHIVE
  RESTORE
  PERMANENT_DELETE
  DRIVE_AUTHORIZED
  DRIVE_AUTH_REVOKED
}

enum LifecycleStateKey {
  DISCOVERED
  SUBMITTED
  IN_PROGRESS
  OFFER
  CLOSED
  CANCELLED
  REJECTED
}

enum ApplicationPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum OpportunityEventType {
  OPPORTUNITY_CREATED
  OPPORTUNITY_SUBMITTED
  OPPORTUNITY_IN_PROGRESS
  OFFER_RECEIVED
  OPPORTUNITY_CLOSED
  OPPORTUNITY_CANCELLED
  OPPORTUNITY_REJECTED

  INTERVIEW_SCHEDULED
  INTERVIEW_COMPLETED
  DOCUMENT_REQUESTED
  TRANSCRIPT_REQUESTED
  DIPLOMA_REQUESTED
  CERTIFICATE_REQUESTED
  LANGUAGE_PROOF_REQUESTED
  CHALLENGE_RECEIVED
  CHALLENGE_SUBMITTED
  COMMUNICATION
  CUSTOM
}

enum ArtefactType {
  CV
  COVER_LETTER
  JOB_DESCRIPTION
  COMPANY_RESEARCH
  PRESENTATION
  PORTFOLIO_EVIDENCE
  TRANSCRIPT
  CERTIFICATE
  AUDIO
  VIDEO
  OTHER
}

enum CommunicationDirection {
  INCOMING
  OUTGOING
}

enum ContactRoleType {
  RECRUITER
  HIRING_MANAGER
  INTERVIEWER
  REFERRAL
  HR
  OTHER
}

enum UserActionStatus {
  TODO
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum UserActionPriority {
  LOW
  NORMAL
  HIGH
}

enum ScheduledEventType {
  INTERVIEW
  RECRUITER_CALL
  PRESENTATION
  CHALLENGE_DEADLINE
  FOLLOW_UP
  OTHER
}

enum StorageProvider {
  GOOGLE_DRIVE
  EXTERNAL
}

// -----------------------------------------------------------------------------
// Identity and ownership
// -----------------------------------------------------------------------------

model OwnerAccount {
  id            String  @id @default(uuid())
  googleSubject String  @unique
  email         String  @unique
  displayName   String?

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  lastSignInAt DateTime?

  opportunities   Opportunity[]
  artefacts       Artefact[]
  lifecycleStates LifecycleStatus[]
  roleFamilies    RoleFamily[]
  contacts        Contact[]
  auditEvents     AuditEvent[]
}

model AuditEvent {
  id         String         @id @default(uuid())
  ownerId    String
  type       AuditEventType
  occurredAt DateTime       @default(now())
  targetType String?
  targetId   String?
  metadata   Json?

  owner OwnerAccount @relation(fields: [ownerId], references: [id], onDelete: Restrict)

  @@index([ownerId, occurredAt])
  @@index([targetType, targetId])
}

// -----------------------------------------------------------------------------
// Lifecycle configuration
// -----------------------------------------------------------------------------

model LifecycleStatus {
  id      String @id @default(uuid())
  ownerId String

  // Stable semantic identity. Labels may be customized without changing
  // the meaning of the lifecycle state.
  key       LifecycleStateKey
  label     String
  sortOrder Int

  isTerminal Boolean @default(false)
  isActive   Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner         OwnerAccount          @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  opportunities Opportunity[]
  outgoing      LifecycleTransition[] @relation("LifecycleTransitionFrom")
  incoming      LifecycleTransition[] @relation("LifecycleTransitionTo")

  @@unique([ownerId, key])
  @@unique([ownerId, label])
  @@index([ownerId, sortOrder])
}

model LifecycleTransition {
  id String @id @default(uuid())

  fromStatusId String
  toStatusId   String

  createdAt DateTime @default(now())

  fromStatus LifecycleStatus @relation("LifecycleTransitionFrom", fields: [fromStatusId], references: [id], onDelete: Cascade)
  toStatus   LifecycleStatus @relation("LifecycleTransitionTo", fields: [toStatusId], references: [id], onDelete: Cascade)

  @@unique([fromStatusId, toStatusId])
  @@index([fromStatusId])
  @@index([toStatusId])
}

// -----------------------------------------------------------------------------
// Supporting taxonomy
// -----------------------------------------------------------------------------

model RoleFamily {
  id      String @id @default(uuid())
  ownerId String

  name      String
  sortOrder Int
  isActive  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner         OwnerAccount  @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  opportunities Opportunity[]

  @@unique([ownerId, name])
  @@index([ownerId, sortOrder])
}

// -----------------------------------------------------------------------------
// Opportunity aggregate
// -----------------------------------------------------------------------------

model Opportunity {
  id      String @id @default(uuid())
  ownerId String

  version    Int       @default(1)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  archivedAt DateTime?

  companyName   String
  positionTitle String

  jobUrl   String?
  location String?
  country  String?

  source   String?
  fitScore Int?
  priority ApplicationPriority @default(NORMAL)

  discoveredAt DateTime @default(now())

  statusId     String
  roleFamilyId String?

  nextActionTitle String?
  nextActionDueAt DateTime?

  owner      OwnerAccount    @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  status     LifecycleStatus @relation(fields: [statusId], references: [id], onDelete: Restrict)
  roleFamily RoleFamily?     @relation(fields: [roleFamilyId], references: [id], onDelete: SetNull)

  submission      Submission?
  events          OpportunityEvent[]
  notes           OpportunityNote[]
  actions         UserAction[]
  scheduledEvents ScheduledEvent[]
  artefacts       OpportunityArtefact[]
  communications  Communication[]
  contacts        OpportunityContact[]

  @@index([ownerId, archivedAt])
  @@index([ownerId, statusId])
  @@index([ownerId, discoveredAt])
  @@index([ownerId, priority])
  @@index([ownerId, roleFamilyId])
  @@index([ownerId, country])
  @@index([ownerId, source])
  @@index([nextActionDueAt])
}

// -----------------------------------------------------------------------------
// Opportunity notes
// -----------------------------------------------------------------------------

model OpportunityNote {
  id            String @id @default(uuid())
  opportunityId String

  title        String?
  bodyMarkdown String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@index([opportunityId, createdAt])
}

// -----------------------------------------------------------------------------
// Opportunity lifecycle and domain events
// -----------------------------------------------------------------------------

model OpportunityEvent {
  id            String @id @default(uuid())
  opportunityId String

  occurredAt DateTime
  type       OpportunityEventType

  title               String
  descriptionMarkdown String?

  systemGenerated Boolean @default(false)

  createdAt DateTime @default(now())

  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  artefacts EventArtefact[]

  @@index([opportunityId, occurredAt])
  @@index([opportunityId, type])
}

// -----------------------------------------------------------------------------
// Artefact aggregate
// -----------------------------------------------------------------------------

model Artefact {
  id      String @id @default(uuid())
  ownerId String

  name        String
  type        ArtefactType
  description String?

  // At least one of contentMarkdown, externalUrl or storageReference
  // must be present. This invariant is enforced by the domain/service layer.
  contentMarkdown String?
  externalUrl     String?

  storageProvider  StorageProvider?
  storageReference String?

  mimeType String?

  archivedAt DateTime?

  createdAt DateTime @default(now())

  owner OwnerAccount @relation(fields: [ownerId], references: [id], onDelete: Restrict)

  opportunities          OpportunityArtefact[]
  submissionCv           Submission[]            @relation("SubmissionCvArtefact")
  submissionCoverLetters Submission[]            @relation("SubmissionCoverLetterArtefact")
  eventLinks             EventArtefact[]
  communications         CommunicationArtefact[]

  @@index([ownerId, archivedAt])
  @@index([ownerId, type])
}

// -----------------------------------------------------------------------------
// Opportunity–Artefact association
// -----------------------------------------------------------------------------

model OpportunityArtefact {
  id            String @id @default(uuid())
  opportunityId String
  artefactId    String

  createdAt DateTime @default(now())

  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  artefact    Artefact    @relation(fields: [artefactId], references: [id], onDelete: Restrict)

  @@unique([opportunityId, artefactId])
  @@index([artefactId])
}

// -----------------------------------------------------------------------------
// Event–Artefact association
// -----------------------------------------------------------------------------

model EventArtefact {
  id         String @id @default(uuid())
  eventId    String
  artefactId String

  createdAt DateTime @default(now())

  event    OpportunityEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  artefact Artefact         @relation(fields: [artefactId], references: [id], onDelete: Restrict)

  @@unique([eventId, artefactId])
  @@index([artefactId])
}

// -----------------------------------------------------------------------------
// Submission
// -----------------------------------------------------------------------------

model Submission {
  id            String @id @default(uuid())
  opportunityId String @unique

  submittedAt DateTime
  method      String?
  notes       String?

  cvArtefactId          String?
  coverLetterArtefactId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  cvArtefact          Artefact? @relation("SubmissionCvArtefact", fields: [cvArtefactId], references: [id], onDelete: Restrict)
  coverLetterArtefact Artefact? @relation("SubmissionCoverLetterArtefact", fields: [coverLetterArtefactId], references: [id], onDelete: Restrict)

  @@index([submittedAt])
  @@index([cvArtefactId])
  @@index([coverLetterArtefactId])
}

// -----------------------------------------------------------------------------
// User actions
// -----------------------------------------------------------------------------

model UserAction {
  id            String @id @default(uuid())
  opportunityId String

  title               String
  descriptionMarkdown String?

  status   UserActionStatus   @default(TODO)
  priority UserActionPriority @default(NORMAL)

  dueAt       DateTime?
  completedAt DateTime?

  version Int @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@index([opportunityId, status])
  @@index([opportunityId, dueAt])
}

// -----------------------------------------------------------------------------
// Scheduled events
// -----------------------------------------------------------------------------

model ScheduledEvent {
  id            String @id @default(uuid())
  opportunityId String

  type  ScheduledEventType
  title String

  scheduledAt DateTime
  endAt       DateTime?
  timeZone    String?

  platform   String?
  meetingUrl String?

  notesMarkdown String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  contacts ScheduledEventContact[]

  @@index([opportunityId, scheduledAt])
  @@index([scheduledAt])
}

// -----------------------------------------------------------------------------
// Contacts
// -----------------------------------------------------------------------------

model Contact {
  id      String @id @default(uuid())
  ownerId String

  name         String
  roleType     ContactRoleType?
  organization String?
  email        String?
  phone        String?
  profileUrl   String?
  notes        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner           OwnerAccount            @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  opportunities   OpportunityContact[]
  communications  Communication[]
  scheduledEvents ScheduledEventContact[]

  @@index([ownerId])
  @@index([ownerId, email])
}

model OpportunityContact {
  id            String @id @default(uuid())
  opportunityId String
  contactId     String

  contextualRole String?
  notes          String?

  createdAt DateTime @default(now())

  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  contact     Contact     @relation(fields: [contactId], references: [id], onDelete: Restrict)

  @@unique([opportunityId, contactId])
  @@index([contactId])
}

model ScheduledEventContact {
  id               String @id @default(uuid())
  scheduledEventId String
  contactId        String

  createdAt DateTime @default(now())

  scheduledEvent ScheduledEvent @relation(fields: [scheduledEventId], references: [id], onDelete: Cascade)
  contact        Contact        @relation(fields: [contactId], references: [id], onDelete: Restrict)

  @@unique([scheduledEventId, contactId])
  @@index([contactId])
}

// -----------------------------------------------------------------------------
// Communications
// -----------------------------------------------------------------------------

model Communication {
  id            String @id @default(uuid())
  opportunityId String

  occurredAt DateTime
  direction  CommunicationDirection

  sender       String?
  recipient    String?
  subject      String?
  bodyMarkdown String?

  contactId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  contact     Contact?    @relation(fields: [contactId], references: [id], onDelete: SetNull)

  artefacts CommunicationArtefact[]

  @@index([opportunityId, occurredAt])
  @@index([contactId])
}

model CommunicationArtefact {
  id              String @id @default(uuid())
  communicationId String
  artefactId      String

  createdAt DateTime @default(now())

  communication Communication @relation(fields: [communicationId], references: [id], onDelete: Cascade)
  artefact      Artefact      @relation(fields: [artefactId], references: [id], onDelete: Restrict)

  @@unique([communicationId, artefactId])
  @@index([artefactId])
}

