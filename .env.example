# Personal Job Application Management System
# Copy this file to .env.local and replace the placeholder values.
# Never commit real credentials.

# Configured application owner
OWNER_EMAIL=owner@example.com

# PostgreSQL connection
DATABASE_URL=postgresql://user:password@localhost:5432/job_applications
DATABASE_URL_TEST=postgresql://postgres:<password>@localhost:5432/job_applications_test

# Authentication/session secret
AUTH_SECRET=replace-with-a-long-random-secret

# Google OAuth / OIDC
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REDIRECT_URI=http://localhost:3000/api/storage/google-drive/callback